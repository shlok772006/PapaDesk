rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow read access to all authenticated users (operators and admins)
      allow read: if request.auth != null;
      
      // Allow write access only if user is an operator or does not have a role assigned yet (for onboarding)
      // Statically blocks writes for users with 'admin' role claim
      allow write: if request.auth != null && 
        (request.auth.token.role == 'operator' || !('role' in request.auth.token));
    }
  }
}